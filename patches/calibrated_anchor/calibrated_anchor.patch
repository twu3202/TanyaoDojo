+    # 收益只出现在押退/立直)。行号只对 v4 观测(1012 行)有效:857–859 = 三家对手 riichi_accepted,869 = 自家
+    # riichi_accepted,按回放标签实测定位(18,506 个决策里与 exposed 只差 19 个 = 自家宣言立直那一打)。
+    anchor_margin_states = anchor_cfg.get('margin_states', 'all')
+    assert anchor_margin_states in ('all', 'pushfold_riichi'), 'anchor margin_states must be all or pushfold_riichi'
+    assert anchor_margin_states == 'all' or version == 4, 'margin_states pushfold_riichi needs obs version 4'
+    if anchor_mortal is not None and (anchor_margin_scale != 1.0 or anchor_margin_level != 'anchor'):
+        logging.info(f'calibrated anchor: margin_scale={anchor_margin_scale}, margin_level={anchor_margin_level}, margin_states={anchor_margin_states}')
 
