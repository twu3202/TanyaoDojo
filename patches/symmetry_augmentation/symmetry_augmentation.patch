+    def load_symmetrized(self, file_list):
+        # 逐文件读 gz 文本 → symaug.relabel → GameplayLoader.load_log(与 load_gz_log_files 内部同一条解析路径);
+        # 读不了的文件按上面的补丁同样跳过
+        data = []
+        for filename in file_list:
+            try:
+                with gzip.open(filename, 'rt', encoding='utf-8') as f:
+                    raw = f.read()
+                g = random.randrange(symaug.N_ELEMENTS)
+                data.append(self.loader.load_log(symaug.relabel(raw, g)))
+            except (RuntimeError, OSError, EOFError, UnicodeDecodeError) as e:
+                logging.warning(f"skipping unreadable log {filename}: {str(e).splitlines()[0]}")
+        return data
+
