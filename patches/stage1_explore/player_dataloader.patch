+# 本地补丁(2026-09-30,B 分支 Stage 1):Q 目标是整局奖励(gamma=1),同局所有决策共用。
+# 一次探索(非贪心动作)会改变该局结果,所以同一局里它之前的决策的目标不再是当前策略的回报 → 丢弃。
+# 探索那一步本身及之后保留(目标 = 采取探索动作后按策略继续)。样本与牌谱事件逐条对齐:
+# 去掉开杠后的选杠样本,标签 <=36 对应该玩家的 dahai、37 对应 reach、38-42 对应吃/碰/杠,顺序一致。
+DROP_PRE_EXPLORE = bool(config.get('explore', {}).get('drop_pre_explore', False))
+_TILE = {t: i for i, t in enumerate(
+    [f'{n}{s}' for s in 'mps' for n in range(1, 10)] + ['E', 'S', 'W', 'N', 'P', 'F', 'C', '5mr', '5pr', '5sr'])}
+
+
+def explore_keep_mask(raw_lines, player_id, actions, at_kyoku):
+    """Boolean keep mask over one player's entries, or None if the log and the entries do not line up."""
+    evs = []
+    for ln in raw_lines:
+        ev = json.loads(ln)
+        t = ev['type']
+        if t == 'start_kyoku':
+            evs.append({'dahai': [], 'reach': [], 'call': []})
+        elif t in ('dahai', 'reach', 'chi', 'pon', 'daiminkan', 'kakan', 'ankan') and ev.get('actor') == player_id:
+            g = (ev.get('meta') or {}).get('is_greedy', True)
+            key = 'dahai' if t == 'dahai' else 'reach' if t == 'reach' else 'call'
+            evs[-1][key].append((_TILE[ev['pai']] if t == 'dahai' else t, g))
+    keep = np.ones(len(actions), dtype=bool)
+    at_kyoku = (np.frombuffer(at_kyoku, dtype=np.uint8) if isinstance(at_kyoku, (bytes, bytearray))
+                else np.asarray(at_kyoku))   # libriichi hands Vec<u8> over as bytes
+    for k in np.unique(at_kyoku):
+        idx = np.nonzero(at_kyoku == k)[0]
+        if k >= len(evs):
+            return None
+        ptr = {'dahai': 0, 'reach': 0, 'call': 0}
+        last_ng = -1
+        prev = None
+        for j in idx:
+            a = int(actions[j])
+            if prev == 42:                      # kan-select entry right after a kan entry
+                prev = 'ks'
+                continue
+            prev = a
+            key = 'dahai' if a <= 36 else 'reach' if a == 37 else 'call' if a <= 42 else None
+            if key is None:
+                continue
+            lst = evs[k][key]
+            if ptr[key] >= len(lst):
+                return None
+            what, g = lst[ptr[key]]
+            ptr[key] += 1
+            if key == 'dahai' and what != a:
+                return None
+            if not g:
+                last_ng = j
+        if any(ptr[key] != len(evs[k][key]) for key in ptr):
+            return None
+        if last_ng >= 0:
+            keep[idx[idx < last_ng]] = False
+    return keep
+
